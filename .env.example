# ---------------------------------------------------------------------------
# Endpointer environment configuration
#
# None of these are required. Endpointer's core — directory, playground, code
# generation, collections, sharing — is fully client-side and works with no
# .env at all. These only enable the optional server-backed features.
# ---------------------------------------------------------------------------

# Enables the AI Copilot and schema assistant. Without it, /api/ai-* return 503
# and the UI reports "AI offline" rather than silently faking an AI response.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Comma-separated hostname allowlist for the built-in CORS proxy (/api/proxy).
# The proxy refuses every host not listed here. Empty disables the proxy.
# "*" allows any *public* host — private, loopback, link-local and cloud
# metadata addresses are blocked unconditionally regardless of this setting.
PROXY_ALLOWED_HOSTS=""

# Requests per minute per IP for /api/proxy, /api/ping-batch and /api/ai-*.
RATE_LIMIT_PER_MINUTE="60"

# Optional: URL of a deployed Cloudflare Worker proxy (see worker/README.md).
# Baked into the static build so the proxy toggle also works on GitHub Pages.
VITE_PROXY_URL=""
